# Development Environment Settings

# Set this to your local frontend URL (including port)
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Backend API URL - already set in your app
NEXT_PUBLIC_API_BASE_URL=https://formhook-backend-rnvw.onrender.com

# Authentication method
NEXT_PUBLIC_USE_HTTP_ONLY_COOKIES=false

# Development mode flag
NEXT_PUBLIC_DEV_MODE=true

FORMHOOK_SERVICE_TOKEN=your_generated_token_here
