# Authentication Settings
# Set to 'true' to use HTTP-only cookies (recommended for production)
# Set to 'false' to use JWT in localStorage (less secure, but easier for development)
NEXT_PUBLIC_USE_HTTP_ONLY_COOKIES=false

# API Base URL
NEXT_PUBLIC_API_BASE_URL=https://formhook-backend.onrender.com

# Optional: canonical profile endpoint path or absolute URL
# If your backend exposes a profile endpoint for the current user, set it here (e.g. `/auth/me`).
# If unset, the frontend will prefer the `user` object returned in the `/auth/login` response.
NEXT_PUBLIC_PROFILE_ENDPOINT=

# Security Settings
# Minimum password length required (client-side validation)
NEXT_PUBLIC_MIN_PASSWORD_LENGTH=8

# Should we enforce password complexity? (client-side validation)
NEXT_PUBLIC_ENFORCE_PASSWORD_COMPLEXITY=true
